# Copy to .env.snp on the host and fill in. .env.snp is gitignored — never commit it.
#
#   cp .env.snp.example .env.snp
#   docker compose -f docker-compose.snp.yml --env-file .env.snp up -d --build

# Symfony secret. The repo's committed .env has a public placeholder, so this MUST be
# overridden. Generate one with:  openssl rand -hex 32
APP_SECRET=

# MySQL credentials for the bundled database container.
#
# MySQL rather than Postgres because upstream's migrations are MySQL-flavoured
# (AUTO_INCREMENT / utf8mb4 / InnoDB), despite their .env defaulting to postgresql.
DB_NAME=grimoire
DB_USER=grimoire
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Host port. Reachable at http://<box-lan-ip>:<PORT> on the shop LAN only.
PORT=8088

# Set to 1 after the first successful boot to skip the reference-data import on
# restart. The import is safe to repeat, just slow.
PG_SKIP_IMPORT=0

# --- Sip n Play bridge -------------------------------------------------------------
# Lets the "Name yourself" box suggest players who signed up for tonight, and (later)
# lets a finished game report itself to the leaderboard.
#
# The key is read ONLY by SnpController, server-side. It is never rendered into the
# page — this app has no login and gets handed around a table on a shared phone.
#
# Must match BOTC_BRIDGE_API_KEY in snp-site's environment. Leave both blank to turn
# the integration off; the grimoire works fine without it.
SNP_BRIDGE_URL=https://sipnplay.cafe
SNP_BRIDGE_KEY=

# Game nights are dated in cafe local time. The container runs UTC, where 04:00 is
# already the next day in Saigon.
SNP_TIMEZONE=Asia/Ho_Chi_Minh
